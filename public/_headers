# Cloudflare Pages response headers.
#
# Cloudflare's default for a static asset is revalidate-on-every-request, which
# on a phone means a round trip for every chunk on every screen. The rules below
# only mark things immutable when the URL genuinely cannot change meaning.

# Next's build output carries a content hash in every filename, so a given URL's
# bytes are fixed forever. This is the one safe place for a year-long max-age.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# The service worker is the one file that can strand someone on an old build.
# It must always be refetched, so a fix to it lands on the next page view.
/sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /

# The Clarity gate and the loader the 53 hand-written articles reference. Same
# reasoning as /sw.js above: neither filename carries a content hash, and one of
# the two IS the allowlist that decides which pages may be recorded at all. A
# copy pinned at the edge would keep recording a route after that route had been
# taken off the list, so both are revalidated on every request. They are roughly
# a kilobyte each and a revalidation is a 304.
/clarity-gate.js
  Cache-Control: no-cache
/clarity-static.js
  Cache-Control: no-cache

# The 90-day programs and the 533-video catalog are large and change only on a
# redeploy, and their filenames are not hashed. A day of edge cache with
# revalidation keeps the Exercises tab quick without risking a stale catalog.
/content/*
  Cache-Control: public, max-age=86400, must-revalidate

# Inter, self hosted, for the 53 legacy articles and /contact. Those pages are
# outside the app router, so they cannot use the hashed copy next/font emits
# under /_next/static; they used to pull the family from fonts.googleapis.com
# on the critical path instead.
#
# Safe to mark immutable because the version is in the filename. Changing the
# typeface means adding -v2 and pointing public/blog-legacy.css at it, never
# overwriting -v1: a year-long immutable copy of the old bytes will be sitting
# in browsers that already loaded it.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Images and the paywall clip are stable and heavy.
/*.png
  Cache-Control: public, max-age=604800
/*.mp4
  Cache-Control: public, max-age=2592000

# Keep the private surfaces out of every index, by a mechanism that does not
# depend on robots.txt.
#
# Two reasons this is not left to robots.txt alone.
#
# First, robots.txt at this domain is not currently ours. Cloudflare's "Managed
# robots.txt" prepends its own `User-agent: *` group ahead of the site's, so the
# site's group is the second one in the file and a parser that honours only the
# first match never reads our Disallow lines. A response header has no
# equivalent failure: there is nothing to prepend it in front of.
#
# Second, robots.txt only ever asks a crawler not to FETCH a URL. It cannot
# remove one from an index, and a disallowed URL that something else links to
# can still be listed. `noindex` is the directive that actually keeps it out.
#
# The .txt entries are the load-bearing part. Next writes a React Server
# Component payload beside every exported route, so /admin.html has a sibling
# /admin.txt that serves the same screen as text/plain with a 200. The noindex
# meta tag in the HTML does not cover it, because a meta tag is only read inside
# HTML. Verified live before this rule existed: /admin.txt, /app.txt and
# /welcome.txt all returned 200 with no robots directive of any kind.
#
# Deliberately NOT a blanket /*.txt rule, and never widen these to /blog/*.
# That glob would also catch /robots.txt, and one careless edit of it would
# noindex the articles, which are the entire SEO moat. `/app/*` is safe because
# the trailing slash stops it matching /apple-touch-icon.png.
/app
  X-Robots-Tag: noindex, nofollow
/app.txt
  X-Robots-Tag: noindex, nofollow
/app/*
  X-Robots-Tag: noindex, nofollow
/admin
  X-Robots-Tag: noindex, nofollow, nocache
/admin.txt
  X-Robots-Tag: noindex, nofollow, nocache
/video
  X-Robots-Tag: noindex, nofollow, noarchive, nocache
/video.txt
  X-Robots-Tag: noindex, nofollow, noarchive, nocache
/video/*
  X-Robots-Tag: noindex, nofollow, noarchive, nocache
/welcome
  X-Robots-Tag: noindex, nofollow
/welcome.txt
  X-Robots-Tag: noindex, nofollow

# The paid ad landing page's HTML is deliberately NOT headered: it carries meta
# noindex, follow (see app/stop-bladder-leaks/page.js), and it must stay
# crawlable for Google Ads' landing page quality checks, so robots.txt does not
# name it either. Its RSC .txt sibling has no meta tag to carry that directive,
# so the header does that one's job, exactly as for /app.txt above.
/stop-bladder-leaks.txt
  X-Robots-Tag: noindex, nofollow

# Nothing under the member app or the owner dashboard should sit in a shared
# cache, and neither should the funnel HTML, which has to reflect a redeploy at
# once.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
