# Cloudflare Pages response headers.
#
# Cloudflare's default for a static asset is revalidate-on-every-request, which
# on a phone means a round trip for every chunk on every screen. The rules below
# only mark things immutable when the URL genuinely cannot change meaning.

# Next's build output carries a content hash in every filename, so a given URL's
# bytes are fixed forever. This is the one safe place for a year-long max-age.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# The service worker is the one file that can strand someone on an old build.
# It must always be refetched, so a fix to it lands on the next page view.
/sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /

# The 90-day programs and the 533-video catalog are large and change only on a
# redeploy, and their filenames are not hashed. A day of edge cache with
# revalidation keeps the Exercises tab quick without risking a stale catalog.
/content/*
  Cache-Control: public, max-age=86400, must-revalidate

# Images and the paywall clip are stable and heavy.
/*.png
  Cache-Control: public, max-age=604800
/*.mp4
  Cache-Control: public, max-age=2592000

# Nothing under the member app or the owner dashboard should sit in a shared
# cache, and neither should the funnel HTML, which has to reflect a redeploy at
# once.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
